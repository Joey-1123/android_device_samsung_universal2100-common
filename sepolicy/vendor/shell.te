# shell.te 

allow shell sysfs_wifi:dir { open read };
allow shell sysfs_wifi:dir search;
allow shell sysfs_wifi:file getattr;
allow shell sysfs_wifi_writable:file getattr;

allow shell sysfs_wakeup_reasons:dir search;
allow shell sysfs_wakeup_reasons:dir { open read };
allow shell sysfs_wakeup_reasons:file getattr;

allow shell sysfs:file getattr;
allow shell shell:dir write;
allow shell efs_file:dir getattr;
allow shell hwc_vendor_file:file getattr;
allow shell sysfs_gpu_writable:file getattr;
allow shell sysfs_kernel_notes:file getattr;
allow shell vendor_file:file getattr;
