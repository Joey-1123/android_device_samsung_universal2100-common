typeattribute hal_power_default mlstrustedsubject;

r_dir_file(hal_power_default, sysfs_battery);

allow hal_power_default {
    sysfs_app_launch_writable
    sysfs_battery_writable
    sysfs_decon
    sysfs_gpu_writable
    sysfs_int_writable
    sysfs_mali_writable
    sysfs_mif_writable
    sysfs_power_writable
    sysfs_ufs_writable
}:dir r_dir_perms;

allow hal_power_default {
    sysfs_ss_writable
    sysfs_app_launch_writable
    sysfs_battery_writable
    sysfs_ems_writable
    sysfs_gpu_writable
    sysfs_int_writable
    sysfs_mali_writable
    sysfs_mif_writable
    sysfs_power_writable
    sysfs_ufs_writable
}:file rw_file_perms;

## FIXME ##
allow hal_power_default sysfs:file write;
allow hal_power_default pm_qos_device:chr_file { open  write };
allow hal_power_default sysfs_wakeup:file { open write };
allow hal_power_default sysfs_battery_writable:file write;

allow hal_power_default sysfs_touchscreen_writable:file write;
allow hal_power_default sysfs_touchscreen_writable:file open;
allow hal_power_default sysfs_power:file write;
allow hal_power_default sysfs_gpu:file rw_file_perms;
allow hal_power_default sysfs_ems_writable:file rw_file_perms;
allow hal_power_default sysfs_ems_writable:file { open write };
allow hal_power_default hal_power_default:capability sys_nice;
allow hal_power_default platform_app:process setsched;

# Set scheduling info for apps (for adpf)
allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default self:capability sys_nice;

# Set scheduling info for surfaceflinger (for adpf)
allow hal_power_default surfaceflinger:process setsched;

# Set scheduling info for HWC (for adpf)
allow hal_power_default hal_graphics_composer_default:process setsched;

# Set scheduling info for system_server (for adpf)
allow hal_power_default system_server:process setsched;
